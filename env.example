# Copy to .env and adjust (do not commit real secrets).
# If unreachable at startup or during requests, the API still runs: chat returns replies
# without saving history; session/username returns an empty chat_history.
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Comma-separated browser origins allowed to call the API (dev defaults include Vite).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional: OneDrive resume link generation (see tushar/one_drive_resume_handler.py)
ONEDRIVE_RESID=
ONEDRIVE_AUTHKEY=

# Frontend build only: leave empty when the API is served from the same origin.
# Example split deploy: VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Netlify: only the frontend build is deployed. Set Netlify build env VITE_API_BASE_URL to your
# hosted API URL, OR leave it empty and use netlify.toml proxy (see netlify.toml comments).
# On the API, add your https://*.netlify.app site to CORS_ORIGINS.
